{
  "name": "@commerce/plugin-ai-image",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "commerce": {
    "manifestVersion": 1,
    "id": "official.ai-image",
    "title": "AI 批图",
    "description": "使用轻作共享 AI 图像能力批量编辑图片，支持自定义提示词与多模型批处理",
    "category": "图片处理",
    "api": "^1.2.0",
    "ui": "ui/index.html",
    "releaseNotes": "图像服务统一由轻作设置管理，插件不再保存服务商密钥或直接访问图像 API。",
    "permissions": {
      "files": true,
      "ai": [
        "image-edit"
      ]
    },
    "icon": "data:image/png;base64,"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "test:host": "node tests/host.mjs",
    "test:market": "node tests/market.mjs"
  },
  "dependencies": {
    "@commerce/plugin-sdk": "file:vendor/commerce-plugin-sdk-1.2.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "license": "MIT"
}
